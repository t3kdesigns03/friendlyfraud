# ---------------------------------------------------------------------------
# Friendly Fraud — environment
# Copy to .env.local for local dev. Set the same keys in Netlify for prod.
# ---------------------------------------------------------------------------

# Shared guild passcode: unlocks every write action. Reads are public.
GUILD_PASSCODE=
# Random string used to sign session cookies (openssl rand -base64 32).
SESSION_SECRET=

# Supabase Postgres connection string. Use the *transaction pooler* URI
# (port 6543) from Supabase → Project Settings → Database.
# Leave empty locally to use the embedded database in ./.data (auto-migrated).
DATABASE_URL=

# --- Blizzard API (dark until the probe finds a Forever namespace) ---------
# Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
# Bearer token the Netlify scheduled function uses to call /api/probe.
PROBE_SECRET=
# Optional: where to post "API is live" notices (Discord/Slack incoming webhook).
PROBE_NOTIFY_WEBHOOK_URL=
# Optional overrides for guesses about Forever's API shape:
# BLIZZARD_FOREVER_NAMESPACE_TAGS=forever,classicforever,classic-forever
# BLIZZARD_PROFILE_PATH_TEMPLATES=/profile/wow/character/{ruleset}/{first}-{second},/profile/wow/character/{first}-{second}
# BLIZZARD_PROBE_CHARACTER=First Second/normal
# BLIZZARD_GUILD_ROSTER_PATH=/data/wow/guild/{guild}/roster
# Set to 1 to keep sync off even if the probe flips the flag.
# BLIZZARD_SYNC_DISABLED=
